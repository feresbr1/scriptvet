{
  "name": "scriptvet",
  "version": "1.0.1",
  "description": "See what every dependency's install script actually does, then generate the allowlist npm 12, pnpm 11, Yarn and Bun need. In your browser or terminal.",
  "type": "module",
  "license": "MIT",
  "author": "Feres Ben Brahim",
  "homepage": "https://feresbr1.github.io/scriptvet/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feresbr1/scriptvet.git"
  },
  "bugs": {
    "url": "https://github.com/feresbr1/scriptvet/issues"
  },
  "keywords": [
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "install-scripts",
    "postinstall",
    "allowScripts",
    "allowBuilds",
    "trustedDependencies",
    "npm-v12",
    "supply-chain-security",
    "lockfile"
  ],
  "bin": {
    "scriptvet": "dist/cli/scriptvet.mjs"
  },
  "files": [
    "dist/cli",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:cli",
    "build:web": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview --port 4175 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "preact": "^10.27.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
